{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "古画临摹工艺谱系库领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "REFERENCE_FROZEN",
        "MATERIAL_TESTED",
        "STAGE_ATTESTED",
        "OBJECT_ACCESSIONED",
        "LABEL_REVISED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "reference_work",
        "replica_project",
        "material_lot",
        "collection_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
